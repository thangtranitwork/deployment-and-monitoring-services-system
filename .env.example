# ==========================================
# Database Configuration
# ==========================================
APP_ENV=local
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=deploy_logs

# SSH Tunnel Configuration (Used if USE_SSH=true or APP_ENV=local)
USE_SSH=false
SSH_HOST=your_ssh_ip
SSH_PORT=22
SSH_USER=ubuntu
SSH_KEY_PATH=C:/Users/username/.ssh/id_rsa
# SSH_PASSWORD=your_ssh_password

# ==========================================
# Remote Agent URLs for Metrics & Health
# ==========================================
DEV_AGENT_URL=http://your_dev_server_ip:55555
STG_AGENT_URL=http://your_stg_server_ip:55555
PROD_AGENT_URL=

# ==========================================
# Web Application Server Settings
# ==========================================
PORT=5555
REACT_PORT=55555
# Modes: 'BOTH' (runs HTML on 5555 & React on 55555), 'REACT', or 'HTML'
APP_MODE=BOTH

# ==========================================
# Docker Host User Home Directory
# (Maps user workspace and .ssh/.gitconfig into Docker container)
# Linux: /home/your_username
# macOS: /Users/your_username
# Windows: C:/Users/your_username
# ==========================================
HOST_HOME=/home/username